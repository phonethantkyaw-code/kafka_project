# Run Python on the SAME Ubuntu machine that publishes Kafka on port 9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=router-commands
# Replace these with your Cisco router's reachable address and SSH login.
ROUTER_HOST=192.168.221.100
ROUTER_PORT=22
ROUTER_USERNAME=admin
ROUTER_PASSWORD=replace-with-your-router-password
# true is for an isolated classroom lab; accepts an unknown SSH host key.
# For verified hosts, use false and a verified ~/.ssh/known_hosts entry.
LAB_ALLOW_UNKNOWN_HOST_KEY=true
